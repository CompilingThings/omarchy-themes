#!/usr/bin/env bash
# Rebuild a theme's wallpapers and preview from their sources.
#
#   src/build <theme>...          rebuild these themes
#   src/build --all               rebuild every theme that can be rebuilt here
#
# Photo themes download their photos once (into ${XDG_CACHE_HOME:-~/.cache}/omarchy-themes/<theme>) and need Python 3
# with Pillow; Snow Crystal also needs numpy and scipy (to cut Bentley's round plates out of the museum scans).
# Seahorse Valley draws its fractals and also needs gcc with OpenMP and numpy. The turning Earth of Low Orbit is
# rendered by src/earthspin.py on its own (about 75 minutes, see src/README.md). Boardroom and Traceroute are drawn
# from KiCad board files and need KiCad 10: pass the folder that holds the boards with BOARDS=<dir>.
#
# Set PYTHON to use another interpreter (for example a virtual environment with Pillow and numpy).
set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)
root=$(cd "$here/.." && pwd)
python=${PYTHON:-python3}
cache_root=${XDG_CACHE_HOME:-$HOME/.cache}/omarchy-themes

die() { echo "build: $*" >&2; exit 1; }

needs() {  # <python module>...
  local m
  for m in "$@"; do
    "$python" -c "import $m" 2>/dev/null || die "$python cannot import '$m' (set PYTHON=... to an interpreter that can)"
  done
}

photos() {  # <theme>
  local t=$1
  needs PIL
  nice -n 19 "$python" -I "$here/photowall.py" "$root/themes/$t/wallpapers.json" "$cache_root/$t" \
    "$root/themes/$t/backgrounds" "$root/themes/$t/preview.png"
}

fractals() {  # <theme>
  local t=$1
  needs PIL numpy
  command -v gcc >/dev/null || die "Seahorse Valley needs gcc (with OpenMP) to draw its fractals"
  nice -n 19 "$python" -I "$here/fractalwall.py" "$root/themes/$t/wallpapers.json" "$cache_root/$t"
  photos "$t"
}

boards() {  # <theme>
  local t=$1
  [ -n "${BOARDS:-}" ] || { echo "skip $t: set BOARDS=<folder with the KiCad boards> to rebuild it" >&2; return 0; }
  command -v kicad-cli >/dev/null || die "$t needs KiCad 10 (kicad-cli and its Python module pcbnew)"
  needs PIL numpy
  PYTHON=$python "$here/$t/build" "$BOARDS" "$cache_root/$t" "$root/themes/$t"
}

build() {  # <theme>
  local t=$1
  [ -d "$root/themes/$t" ] || die "no theme called '$t' (see themes/)"
  echo "== $t" >&2
  case $t in
    boardroom | traceroute) boards "$t" ;;
    seahorse-valley) fractals "$t" ;;
    snow-crystal) needs numpy scipy; photos "$t" ;;
    *) photos "$t" ;;
  esac
}

[ $# -gt 0 ] || { sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 2; }
if [ "$1" = --all ]; then
  for d in "$root"/themes/*/; do build "$(basename "$d")"; done
else
  for t in "$@"; do build "$t"; done
fi
